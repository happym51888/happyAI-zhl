---
const lines = [
	{ type: 'cmd', text: 'whoami' },
	{ type: 'out', text: 'Happy' },
	{ type: 'cmd', text: 'cat about.md' },
	{ type: 'out', text: '做了 12 年通信软件的工程师' },
	{ type: 'sub', text: '这两年专注大模型应用：RAG + Agent' },
	{ type: 'sub', text: '核心网 → AI 应用落地，HappyOS building' },
	{ type: 'cmd', text: 'echo "1 person + AI = 1 team"' },
	{ type: 'out', text: '1 person + AI = 1 team' },
	{ type: 'cmd', text: 'open happy-os.app' },
];
---

<div class="boot" id="bootScreen">
	<div class="boot-glow" aria-hidden="true"></div>

	<section class="boot-window" aria-label="开机终端">
		<header class="boot-bar">
			<i></i><i></i><i></i>
			<span>happy@universe ~ zsh</span>
		</header>

		<div class="boot-body" id="bootBody">
			{
				lines.map((line, index) => (
					<p class:list={['boot-line', `boot-${line.type}`]} data-boot-line={index}>
						{line.type === 'cmd' && <b>$</b>}
						{line.type === 'out' && <em>&gt;</em>}
						<span>{line.text}</span>
					</p>
				))
			}
			<p class="boot-cursor" id="bootCursor" aria-hidden="true"><i></i></p>
		</div>

		<button class="boot-launch" id="bootLaunch" type="button">
			<span>Press Enter to Launch</span>
			<b aria-hidden="true">↓</b>
		</button>
	</section>

	<button class="boot-skip" id="bootSkip" type="button">skip →</button>
</div>

<noscript>
	<style>
		#bootScreen {
			display: none;
		}
	</style>
</noscript>
