---
import { withBase } from '../../lib/base';
import type { Card } from './cards';

interface Props {
	card: Card;
}

const { card } = Astro.props;
const tone = card.tone ?? 'plain';
const isInternal = card.href?.startsWith('/') || card.href?.startsWith('#');
const href = card.href ? withBase(card.href) : undefined;
const portrait = withBase('/images/happy-character.webp');
---

<article
	class:list={['card', `card-${card.kind}`, `tone-${tone}`]}
	id={card.id}
	data-card={card.id}
	style={`--x:${card.x}px; --y:${card.y}px; --w:${card.w}px;`}
	tabindex="0"
>
	<span class="card-stripe" aria-hidden="true"></span>

	{
		card.kind === 'hero' && (
			<div class="hero-card">
				<img class="hero-avatar" src={portrait} alt="Happy 的个人形象插画" />
				<p class="eyebrow">{card.eyebrow}</p>
				<h2 class="hero-name">{card.heading}</h2>
				<p class="card-body">{card.body}</p>
				<ul class="chips">
					{card.tags?.map((tag) => <li>{tag}</li>)}
				</ul>
			</div>
		)
	}

	{
		card.kind === 'photo' && (
			<div class="photo-card">
				<span class="photo-tag">HAPPY / CHARACTER</span>
				<img src={portrait} alt="Happy 的蓝黄手绘形象" />
				<span class="photo-caption">核心网工程师 · AI 应用落地</span>
			</div>
		)
	}

	{
		card.kind === 'link' && (
			<>
				<p class="eyebrow">{card.eyebrow}</p>
				<h2 class="card-title">{card.heading}</h2>
				<p class="card-body">{card.body}</p>
				{href ? (
					<a class="card-link" href={href} rel={isInternal ? undefined : 'noreferrer'}>
						{card.cta} <b aria-hidden="true">↗</b>
					</a>
				) : (
					card.cta && <span class="card-hint">{card.cta}</span>
				)}
			</>
		)
	}

	{
		card.kind === 'list' && (
			<>
				<p class="eyebrow">{card.eyebrow}</p>
				<h2 class="card-title">{card.heading}</h2>
				<ul class="bullet-list">
					{card.items?.map((item) => <li>{item}</li>)}
				</ul>
				{card.body && <p class="card-body">{card.body}</p>}
				{href && (
					<a class="card-link" href={href}>
						{card.cta} <b aria-hidden="true">↗</b>
					</a>
				)}
			</>
		)
	}

	{
		card.kind === 'note' && (
			<div class="note-card">
				<h2 class="note-title">{card.heading}</h2>
				<p>{card.body}</p>
			</div>
		)
	}

	{
		card.kind === 'quote' && (
			<blockquote class="quote-card">
				<p>{card.quote}</p>
				<footer>{card.source}</footer>
			</blockquote>
		)
	}

	{
		card.kind === 'timeline' && (
			<>
				<p class="eyebrow">{card.eyebrow}</p>
				<h2 class="card-title">{card.heading}</h2>
				<ol class="timeline">
					{card.steps?.map((step) => (
						<li>
							<span>{step.time}</span>
							<b>{step.title}</b>
							<small>{step.note}</small>
						</li>
					))}
				</ol>
			</>
		)
	}

	{
		card.kind === 'stats' && (
			<>
				<p class="eyebrow">{card.eyebrow}</p>
				<ul class="stat-list">
					{card.stats?.map((stat) => (
						<li>
							<strong>
								{stat.value}
								{stat.unit && <small>{stat.unit}</small>}
							</strong>
							<span>{stat.label}</span>
						</li>
					))}
				</ul>
			</>
		)
	}

	{
		card.kind === 'rows' && (
			<>
				<p class="eyebrow">{card.eyebrow}</p>
				<h2 class="card-title">{card.heading}</h2>
				<ul class="row-list">
					{card.rows?.map((row) => (
						<li>
							<span>{row.tag}</span>
							<b>{row.title}</b>
							<small>{row.note}</small>
						</li>
					))}
				</ul>
			</>
		)
	}

	{
		card.kind === 'terminal' && (
			<div class="mini-terminal">
				<div class="mini-terminal-bar">
					<i></i><i></i><i></i>
					<span>happy@universe ~ zsh</span>
				</div>
				<div class="mini-terminal-body">
					<p><b>$</b> cat contact.md</p>
					<p class="out">
						📮 <a href="mailto:happym51888@gmail.com">happym51888@gmail.com</a>
					</p>
					<p class="out">
						💻 <a href="https://github.com/happym51888" rel="noreferrer">github.com/happym51888</a>
					</p>
					<p class="out">📰 公众号「HappyAI报」</p>
					<p><b>$</b> open ver3</p>
					<p class="out">
						<button type="button" data-open-easter>打开 Ver 3 ↗</button>
					</p>
					<p><b>$</b> exit</p>
					<p class="dim">See you next time.</p>
				</div>
			</div>
		)
	}

	{
		card.kind === 'project' && (
			<div class="project-card">
				{card.image ? (
					<div class="project-cover has-image">
						<img src={withBase(card.image)} alt={card.imageAlt ?? ''} loading="lazy" draggable="false" />
					</div>
				) : (
					<div class="project-cover" aria-hidden="true">
						<span>{card.number}</span>
						<strong>{card.cover}</strong>
						<i></i><i></i>
					</div>
				)}
				<div class="project-copy">
					<div class="project-meta">
						<span>{card.number}</span>
						<b>{card.status}</b>
					</div>
					<h2 class="card-title">{card.heading}</h2>
					<p class="card-body">{card.body}</p>
					{card.role && <p class="project-role">{card.role}</p>}
					{card.tags && (
						<ul class="chips project-tags">
							{card.tags.map((tag) => <li>{tag}</li>)}
						</ul>
					)}
					{href && (
						<a class="card-link" href={href}>
							{card.cta} <b aria-hidden="true">↗</b>
						</a>
					)}
				</div>
			</div>
		)
	}
</article>
