	.companion-launcher {
		position: fixed;
		z-index: 80;
		right: 1.25rem;
		bottom: 1.25rem;
		display: grid;
		width: 4.3rem;
		height: 4.3rem;
		place-items: center;
		padding: 0.55rem;
		border: 1px solid var(--line-strong);
		border-radius: 50%;
		background: var(--ink);
		color: var(--bg);
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.24);
		cursor: pointer;
