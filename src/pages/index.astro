---
import CanvasHome from '../components/CanvasHome.astro';

const learningAreas = [
	{
		index: '01',
		title: 'Understand',
		subtitle: 'LLM fundamentals',
		description: '理解 Token、上下文、Prompt、结构化输出，以及模型能力的真正边界。',
		href: '/llm/',
		tags: ['LLM', 'Prompt', 'Tool Calling'],
	},
	{
		index: '02',
		title: 'Connect',
		subtitle: 'Knowledge with RAG',
		description: '把个人资料变成模型可以检索、引用和验证的外部知识。',
		href: '/rag/',
		tags: ['Embedding', 'Retrieval', 'Reranking'],
	},
	{
		index: '03',
		title: 'Build',
		subtitle: 'Useful AI agents',
		description: '让模型在可控循环中规划、使用工具、观察结果并完成人类目标。',
		href: '/agent/',
		tags: ['Agent', 'State', 'Human-in-loop'],
	},
];

const notes = [
	{
		number: '001',
		title: 'AI Agent 学习路线',
		description: '从 Python、LLM 和 RAG，一步步走到 Agent 工程化。',
		href: '/learning-path/',
		type: 'ROADMAP',
	},
	{
		number: '002',
		title: 'AI 全景概览',
		description: '把模型、知识、工具、框架和治理连接成一张图。',
		href: '/ai-basics/',
		type: 'OVERVIEW',
	},
	{
		number: '003',
		title: 'LangChain 与 LangGraph',
		description: '两个框架分别解决什么问题，以及什么时候应该使用。',
		href: '/frameworks/',
		type: 'FRAMEWORK',
	},
	{
		number: '004',
		title: '评估、追踪与安全',
		description: '从能运行的 Demo，走向可以可靠投入使用的 AI 系统。',
		href: '/production/',
		type: 'ENGINEERING',
	},
];

const capabilities = [
	{
		code: '01 / RESEARCH & THINK',
		title: '研究与思考',
		items: [
			['知识地图', '把零散概念连接成可以复习和扩展的系统'],
			['深度学习', '让 AI 辅助检索、比较、质疑和总结'],
			['问题拆解', '从目标、约束和证据出发建立思考框架'],
		],
	},
	{
		code: '02 / CREATE & BUILD',
		title: '创造与构建',
		items: [
			['AI Agent', '从单一工具开始，构建可控的智能工作流'],
			['知识产品', '把学习笔记转化为网站、教程和项目'],
			['快速原型', '用代码验证想法，再持续打磨体验'],
		],
	},
	{
		code: '03 / ANALYZE & OPERATE',
		title: '分析与运行',
		items: [
			['评估系统', '记录质量、成本、延迟和失败原因'],
			['自动化', '让重复流程稳定运行并保留人工确认'],
			['持续迭代', '根据真实反馈更新知识和工具'],
		],
	},
];

const portfolioProjects = [
	{
		dimension: 'dim_01',
		status: 'LIVE',
		title: 'AI 学习知识库',
		description: '从 LLM、RAG 到 Agent，持续生长的个人知识系统。',
		href: '/notes/',
		linkLabel: '打开知识库',
		visual: 'KNOWLEDGE',
		tone: 'violet',
	},
	{
		dimension: 'dim_02',
		status: 'LIVE',
		title: 'AI Agent 全景图',
		description: '用一张关系图理解模型、知识、工具、控制与治理。',
		href: '/projects/ai-agent-whole-picture/',
		linkLabel: '探索全景图',
		visual: 'AGENT MAP',
		tone: 'lime',
	},
	{
		dimension: 'dim_03',
		status: 'BUILDING',
		title: 'HappyAI Personal OS',
		description: '一个管理学习、项目与 AI 协作方式的个人操作系统。',
		href: '#system',
		linkLabel: '查看系统',
		visual: 'HAPPY OS',
		tone: 'orange',
	},
	{
		dimension: 'dim_04',
		status: 'PLACEHOLDER',
		title: '下一个作品',
		description: '为未来的 AI 工具、内容实验和真实项目预留。',
		href: '#contact',
		linkLabel: '等待更新',
		visual: 'COMING SOON',
		tone: 'blue',
	},
];
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Happy 的个人 AI 网站：记录 LLM、RAG、AI Agent 的学习、思考与实践。"
		/>
		<meta name="theme-color" content="#0b0e13" />
		<meta property="og:title" content="HappyAI · ZHL" />
		<meta
			property="og:description"
			content="Learning AI, one system at a time. Happy 的 AI 学习与实践。"
		/>
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://happyai-zhl.happym51888.workers.dev/" />
		<link rel="canonical" href="https://happyai-zhl.happym51888.workers.dev/" />
		<link rel="icon" href="/favicon.svg" />
		<title>HappyAI · ZHL — Learning AI, one system at a time</title>
		<script is:inline>
			(() => {
				try {
					const saved = localStorage.getItem('happyai-theme');
					document.documentElement.dataset.theme = saved || 'dark';
				} catch {
					document.documentElement.dataset.theme = 'dark';
				}
			})();
		</script>
	</head>

	<body class="canvas-mode">
		<CanvasHome />
		{false && (
			<>
				<a class="skip-link" href="#main">跳到主要内容</a>
		<div class="boot-screen" id="bootScreen" role="dialog" aria-labelledby="bootTitle">
			<div class="boot-grid" aria-hidden="true"></div>
			<div class="boot-terminal">
				<div class="boot-command">
					<span>happy@universe</span>
					<i>~</i>
					<b>zsh</b>
				</div>
				<h1 id="bootTitle">HAPPY<span>OS</span></h1>
				<p>1 PERSON + AI = 1 TEAM</p>
				<button id="launchButton" type="button">
					<span>Press Enter to Launch</span>
					<i aria-hidden="true">↓</i>
				</button>
			</div>
			<div class="boot-status">
				<span>SYS.READY</span>
				<span>2026 / PERSONAL AI SYSTEM</span>
			</div>
		</div>

		<header class="site-header">
			<a class="brand" href="/" aria-label="HappyAI 首页">
				<span class="brand-mark">H</span>
				<span class="brand-copy">
					<strong>Happy OS</strong>
					<small>ZHL / HUMAN × AI</small>
				</span>
			</a>

			<nav class="desktop-nav" aria-label="主导航">
				<a href="#home"><span>01</span> 首页</a>
				<a href="#works"><span>02</span> 作品集</a>
				<a href="#system"><span>03</span> 我的 OS</a>
				<a href="/notes/"><span>04</span> 知识库</a>
			</nav>

			<div class="header-actions">
				<span class="system-clock" id="systemClock">--:--</span>
				<button class="theme-toggle" id="themeToggle" type="button" aria-label="切换颜色主题">
					<span class="theme-dark">LIGHT</span>
					<span class="theme-light">DARK</span>
				</button>
				<button
					class="menu-toggle"
					id="menuToggle"
					type="button"
					aria-label="打开导航菜单"
					aria-expanded="false"
					aria-controls="mobileNav"
				>
					<span></span><span></span>
				</button>
			</div>

			<nav class="mobile-nav" id="mobileNav" aria-label="移动端导航" hidden>
				<a href="#home">01 首页</a>
				<a href="#works">02 作品集</a>
				<a href="#system">03 我的 OS</a>
				<a href="/notes/">04 知识库</a>
			</nav>
		</header>

		<main id="main">
			<section class="hero" id="home">
				<div class="hero-grid">
					<div class="hero-copy reveal">
						<p class="terminal-line">
							<span>happy@ai-lab ~ %</span>
							<span class="command">whoami</span>
							<i aria-hidden="true"></i>
						</p>
						<p class="hero-kicker">HAPPY OS / PERSONAL AI SYSTEM / 2026</p>
						<h1>
							1 Person + AI
							<span>= 1 Team.</span>
						</h1>
						<p class="hero-intro">
							这是 Happy 的个人 AI 世界：学习、思考、创造和运行。真实信息、照片与更多作品将在下一阶段接入。
						</p>
						<div class="hero-actions">
							<a class="primary-button" href="#works">
								<span>进入我的世界</span>
								<b aria-hidden="true">↗</b>
							</a>
							<a class="text-link" href="/notes/">
								Open knowledge base
								<span aria-hidden="true">→</span>
							</a>
						</div>
						<ul class="hero-meta" aria-label="个人信息摘要">
							<li><span>IDENTITY</span> HAPPY / ZHL</li>
							<li><span>FOCUS</span> AI × KNOWLEDGE × BUILD</li>
							<li><span>STATUS</span> SYSTEM EVOLVING</li>
						</ul>
					</div>

					<aside class="portrait-panel reveal" aria-label="头像预留区域">
						<div class="portrait-topline">
							<span>IDENTITY.PROFILE</span>
							<span>UPLOAD LATER</span>
						</div>
						<div class="portrait-placeholder">
							<div class="portrait-frame">
								<span class="corner top-left"></span>
								<span class="corner top-right"></span>
								<span class="corner bottom-left"></span>
								<span class="corner bottom-right"></span>
								<div class="portrait-message">
									<small>YOUR PHOTO</small>
									<strong>HAPPY<br />HERE</strong>
									<p>照片与个人简介占位</p>
								</div>
							</div>
						</div>
						<div class="portrait-caption">
							<span>1 PERSON</span>
							<span>+ AI = 1 TEAM</span>
						</div>
					</aside>
				</div>

				<div class="concept-ticker" aria-hidden="true">
					<div>
						<span>HAPPY OS</span><i>✦</i><span>LEARN</span><i>✦</i><span>THINK</span><i>✦</i
						><span>CREATE</span><i>✦</i><span>BUILD</span><i>✦</i><span>AI AGENT</span><i>✦</i
						><span>1 PERSON + AI = 1 TEAM</span>
					</div>
				</div>
			</section>

			<section class="about section-shell" id="about">
				<div class="section-label reveal">
					<span>01</span>
					<p>ABOUT / VALUES / NOW</p>
				</div>
				<div class="about-content reveal">
					<p class="terminal-heading">
						<span>happy@ai-lab ~ %</span> cat about.md
					</p>
					<h2>
						我想建立的，不只是网站。
						<span>而是一套会成长的个人系统。</span>
					</h2>
					<div class="about-columns">
						<p>
							这里将逐步放入我的经历、价值观、当前状态和长期作品。现在先用结构化占位，
							让未来的每一条真实信息都有清晰的位置。
						</p>
						<div class="now-list">
							<div><span>NOW.01</span><b>建立 AI Agent whole picture</b></div>
							<div><span>NOW.02</span><b>学习 RAG 与工具调用</b></div>
							<div><span>NOW.03</span><b>把知识变成可复用项目</b></div>
						</div>
					</div>
				</div>
			</section>

			<section class="learning section-shell" id="learning">
				<div class="section-label reveal">
					<span>02</span>
					<p>LEARNING SYSTEM</p>
				</div>
				<div class="section-intro reveal">
					<p class="terminal-heading"><span>ls</span> learning/</p>
					<h2>Understand. Connect. Build.</h2>
					<p>从基本原理出发，再使用框架；从一个可靠的单 Agent 出发，再考虑复杂系统。</p>
				</div>

				<div class="learning-grid">
					{
						learningAreas.map((area) => (
							<a class="learning-card reveal" href={area.href}>
								<div class="card-index">{area.index}</div>
								<div>
									<p>{area.subtitle}</p>
									<h3>{area.title}</h3>
									<span>{area.description}</span>
								</div>
								<ul>
									{area.tags.map((tag) => <li>{tag}</li>)}
								</ul>
								<b class="card-arrow" aria-hidden="true">↗</b>
							</a>
						))
					}
				</div>
			</section>

			<section class="system-section section-shell" id="system">
				<div class="section-label reveal">
					<span>03</span>
					<p>MY PERSONAL OS</p>
				</div>
				<div class="system-header reveal">
					<div>
						<p class="terminal-heading"><span>open</span> happy-os.app</p>
						<h2>1 Person + AI = 1 Team</h2>
					</div>
					<p>下面是系统能力骨架，后续会替换为你的真实经历、工具和工作流。</p>
				</div>

				<div class="os-window reveal">
					<div class="os-titlebar">
						<div><i></i><i></i><i></i></div>
						<span>happy-os / system-overview</span>
						<b>ONLINE</b>
					</div>
					<div class="os-profile">
						<div class="os-avatar" aria-label="头像占位">H</div>
						<div>
							<span>PROFILE / PLACEHOLDER</span>
							<h3>Happy · AI Learner & Builder</h3>
							<p>城市 · 职业 · MBTI · 经历路径 · 个人标签（等待补充）</p>
						</div>
					</div>
					<div class="capability-grid">
						{
							capabilities.map((capability) => (
								<article class="capability-card">
									<span>{capability.code}</span>
									<h3>{capability.title}</h3>
									<ul>
										{capability.items.map(([name, description]) => (
											<li>
												<b>{name}</b>
												<p>{description}</p>
											</li>
										))}
									</ul>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="notes section-shell" id="notes">
				<div class="section-label reveal">
					<span>04</span>
					<p>LATEST NOTES</p>
				</div>
				<div class="notes-header reveal">
					<div>
						<p class="terminal-heading"><span>find</span> notes/ -type f</p>
						<h2>正在生长的知识库</h2>
					</div>
					<a href="/notes/">All notes <span>→</span></a>
				</div>
				<div class="notes-list">
					{
						notes.map((note) => (
							<a class="note-row reveal" href={note.href}>
								<span class="note-number">{note.number}</span>
								<div>
									<p>{note.type}</p>
									<h3>{note.title}</h3>
								</div>
								<p class="note-description">{note.description}</p>
								<b aria-hidden="true">↗</b>
							</a>
						))
					}
				</div>
			</section>

			<section class="works section-shell" id="works">
				<div class="section-label reveal">
					<span>05</span>
					<p>SELECTED WORKS</p>
				</div>
				<div class="works-heading reveal">
					<p class="terminal-heading"><span>ls</span> projects/</p>
					<h2>作品集</h2>
					<p>先搭建可横向探索的作品空间；图片、文章、工具和项目会在这里逐步替换占位内容。</p>
				</div>
				<div class="works-shell reveal">
					<div class="works-toolbar">
						<span>Scroll 横移 · Drag 移动画布</span>
						<div>
							<button class="canvas-control" data-direction="-1" type="button" aria-label="向左浏览">←</button>
							<button class="canvas-control" data-direction="1" type="button" aria-label="向右浏览">→</button>
						</div>
					</div>
					<div class="works-viewport" id="worksViewport">
						<div class="works-track">
							{
								portfolioProjects.map((project) => (
									<article class:list={['work-card', `tone-${project.tone}`]}>
										<div class="work-visual" aria-hidden="true">
											<span>{project.dimension}</span>
											<strong>{project.visual}</strong>
											<i></i><i></i><i></i>
										</div>
										<div class="work-copy">
											<div><span>{project.dimension}</span><b>{project.status}</b></div>
											<h3>{project.title}</h3>
											<p>{project.description}</p>
											<a href={project.href}>{project.linkLabel} <span>↗</span></a>
										</div>
									</article>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<section class="closing" id="contact">
				<div class="closing-copy reveal">
					<p class="terminal-heading"><span>happy@universe ~ %</span> echo "see you"</p>
					<h2>See you<br />next time.</h2>
					<p>照片、个人信息、社交账号与合作方式将在你提供后接入。</p>
				</div>
				<div class="contact-terminal reveal">
					<p><span>$</span> cat contact.md</p>
					<a href="/notes/">📚 AI 知识库 <b>↗</b></a>
					<a href="https://github.com/happym51888/happyAI-zhl" rel="noreferrer">
						⌘ GitHub repository <b>↗</b>
					</a>
					<p><span>$</span> fortune</p>
					<blockquote>“先把系统搭起来，再让真实生活慢慢填满它。”</blockquote>
					<p><span>$</span> exit</p>
					<small>[Process completed]</small>
				</div>
			</section>
		</main>

		<button
			class="companion-launcher"
			id="companionLauncher"
			type="button"
			aria-label="打开 AI 搭档"
			aria-expanded="false"
			aria-controls="companionPanel"
		>
			<span>AI</span>
			<b>搭档</b>
		</button>
		<aside class="companion-panel" id="companionPanel" aria-label="AI 搭档占位" hidden>
			<header>
				<div>
					<span class="companion-avatar">H</span>
					<p><b>Happy 的 AI 搭档</b><small>coming soon · prototype</small></p>
				</div>
				<button id="companionClose" type="button" aria-label="关闭 AI 搭档">×</button>
			</header>
			<div class="companion-log">
				<p>嘿，我是这个网站未来的 AI 搭档。</p>
				<p>等你补充个人资料后，我可以介绍你的经历、作品、学习路径，以及你如何和 AI 协作。</p>
				<span>当前为界面骨架，尚未连接模型。</span>
			</div>
			<form class="companion-form">
				<input type="text" placeholder="输入消息…" disabled />
				<button type="button" disabled>发送</button>
			</form>
		</aside>

		<footer>
			<div>
				<span>HAPPY OS · ZHL</span>
				<span>1 PERSON + AI = 1 TEAM</span>
			</div>
			<p>© <span id="year">2026</span> Happy · Built with AI & curiosity.</p>
				</footer>
			</>
		)}

		<script>
			const root = document.documentElement;
			const body = document.body;
			const bootScreen = document.querySelector('#bootScreen');
			const launchButton = document.querySelector('#launchButton');
			const themeToggle = document.querySelector('#themeToggle');
			const menuToggle = document.querySelector('#menuToggle');
			const mobileNav = document.querySelector('#mobileNav');
			const systemClock = document.querySelector('#systemClock');
			const worksViewport = document.querySelector('#worksViewport');
			const companionLauncher = document.querySelector('#companionLauncher');
			const companionPanel = document.querySelector('#companionPanel');
			const companionClose = document.querySelector('#companionClose');
			const year = document.querySelector('#year');

			const launchSystem = () => {
				if (!body.classList.contains('is-booting')) return;
				body.classList.remove('is-booting');
				bootScreen?.classList.add('is-launched');
				window.setTimeout(() => {
					if (bootScreen instanceof HTMLElement) bootScreen.hidden = true;
				}, 700);
			};

			launchButton?.addEventListener('click', launchSystem);
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Enter' && body.classList.contains('is-booting')) launchSystem();
			});

			themeToggle?.addEventListener('click', () => {
				const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
				root.dataset.theme = nextTheme;
				localStorage.setItem('happyai-theme', nextTheme);
			});

			menuToggle?.addEventListener('click', () => {
				const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
				menuToggle.setAttribute('aria-expanded', String(!isOpen));
				if (mobileNav instanceof HTMLElement) mobileNav.hidden = isOpen;
			});

			mobileNav?.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => {
					menuToggle?.setAttribute('aria-expanded', 'false');
					if (mobileNav instanceof HTMLElement) mobileNav.hidden = true;
				});
			});

			const updateClock = () => {
				const now = new Date();
				systemClock && (systemClock.textContent = now.toLocaleTimeString('zh-CN', {
					hour: '2-digit',
					minute: '2-digit',
					hour12: false,
				}));
			};

			updateClock();
			window.setInterval(updateClock, 30_000);

			document.querySelectorAll('.canvas-control').forEach((control) => {
				control.addEventListener('click', () => {
					if (!(worksViewport instanceof HTMLElement)) return;
					const direction = Number((control as HTMLElement).dataset.direction || 1);
					worksViewport.scrollBy({ left: direction * 440, behavior: 'smooth' });
				});
			});

			if (worksViewport instanceof HTMLElement) {
				let dragging = false;
				let startX = 0;
				let startScroll = 0;

				worksViewport.addEventListener('pointerdown', (event) => {
					dragging = true;
					startX = event.clientX;
					startScroll = worksViewport.scrollLeft;
					worksViewport.classList.add('is-dragging');
					worksViewport.setPointerCapture(event.pointerId);
				});

				worksViewport.addEventListener('pointermove', (event) => {
					if (!dragging) return;
					worksViewport.scrollLeft = startScroll - (event.clientX - startX);
				});

				const stopDragging = () => {
					dragging = false;
					worksViewport.classList.remove('is-dragging');
				};

				worksViewport.addEventListener('pointerup', stopDragging);
				worksViewport.addEventListener('pointercancel', stopDragging);
			}

			const setCompanionOpen = (open: boolean) => {
				if (companionPanel instanceof HTMLElement) companionPanel.hidden = !open;
				companionLauncher?.setAttribute('aria-expanded', String(open));
			};

			companionLauncher?.addEventListener('click', () => {
				setCompanionOpen(companionLauncher.getAttribute('aria-expanded') !== 'true');
			});
			companionClose?.addEventListener('click', () => setCompanionOpen(false));
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') setCompanionOpen(false);
			});

			if (year) year.textContent = String(new Date().getFullYear());

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.12 },
			);

			document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
		</script>
