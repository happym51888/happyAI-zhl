---
import OsShell from '../components/os/OsShell.astro';

const site = 'https://happyai-zhl.pages.dev';
const description = 'Happy 的个人 AI 系统：终端开机、无限画布、学习笔记与作品集。1 person + AI = 1 team.';
---

<!doctype html>
<html lang="zh-CN" class="os-page">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#faf8f2" />
		<meta property="og:title" content="Happy OS · 1 person + AI = 1 team" />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={`${site}/`} />
		<meta property="og:image" content={`${site}/images/happy-character-blue-yellow.png`} />
		<link rel="canonical" href={`${site}/`} />
		<link rel="icon" href="/favicon.svg" />
		<title>Happy OS — 1 person + AI = 1 team</title>
	</head>

	<body class="os-page">
		<OsShell />
	</body>
</html>
