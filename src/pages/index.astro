	.map-columns {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
		margin-left: 7rem;
	}

	.map-columns div {
		display: flex;
		min-height: 8rem;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		border: 1px solid var(--line);
		background: var(--surface-raised);
		text-align: center;
	}

	.map-columns span {
		color: var(--blue);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.55rem;
		letter-spacing: 0.1em;
	}

	.map-columns b {
		margin: 0.4rem 0 0.2rem;
		font-size: 1.5rem;
	}

	.map-columns small {
		color: var(--muted);
	}

	.map-foundation {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
		margin: 1.25rem 0 0 7rem;
		padding-top: 1.25rem;
		border-top: 1px dashed var(--line-strong);
	}

	.map-foundation span {
		padding: 0.32rem 0.55rem;
		border: 1px solid var(--line);
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.57rem;
	}

	.notes-list {
		grid-column: 2;
		margin-top: 1.5rem;
		border-top: 1px solid var(--line);
	}

	.note-row {
		display: grid;
		grid-template-columns: 4rem minmax(200px, 0.8fr) minmax(260px, 1.2fr) auto;
		gap: 1.5rem;
		align-items: center;
		padding: 1.3rem 0;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
		transition: padding 150ms ease, background-color 150ms ease;
	}

	.note-row:hover {
		padding-inline: 0.85rem;
		background: var(--surface);
	}

	.note-number,
	.note-row div p {
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.58rem;
	}

	.note-row div p {
		margin: 0 0 0.25rem;
		color: var(--blue);
		letter-spacing: 0.08em;
	}

	.note-row h3 {
		margin: 0;
		font-size: clamp(1.15rem, 1.7vw, 1.6rem);
		font-weight: 560;
	}

	.note-description {
		margin: 0;
		color: var(--muted);
		font-size: 0.84rem;
	}

	.note-row > b {
		font-weight: 400;
	}

	.projects-heading {
		margin-bottom: 1.5rem;
	}

	.project-grid {
		grid-column: 2;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.project-card {
		display: grid;
		min-height: 570px;
		grid-template-rows: auto 1fr auto;
		border: 1px solid var(--line);
		background: var(--surface);
	}

	.project-meta {
		display: flex;
		justify-content: space-between;
		padding: 0.9rem 1rem;
		border-bottom: 1px solid var(--line);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.58rem;
	}

	.project-meta span {
		color: var(--muted);
	}

	.project-meta b {
		color: var(--acid);
	}

	.project-visual {
		display: grid;
		min-height: 300px;
		place-items: center;
		overflow: hidden;
		background:
			linear-gradient(var(--grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid) 1px, transparent 1px), var(--surface-raised);
		background-size: 24px 24px;
	}

	.visual-orbit {
		position: relative;
		display: grid;
		width: min(52%, 220px);
		aspect-ratio: 1;
		place-items: center;
		border: 1px solid var(--line-strong);
		border-radius: 50%;
	}

	.visual-orbit::before,
	.visual-orbit::after {
		position: absolute;
		border: 1px solid var(--line);
		border-radius: 50%;
		content: "";
		inset: -18%;
	}

	.visual-orbit::after {
		inset: 18%;
	}

	.visual-orbit i {
		position: absolute;
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--acid);
	}

	.visual-orbit i:nth-child(1) {
		top: -0.3rem;
	}

	.visual-orbit i:nth-child(2) {
		right: 8%;
		bottom: 13%;
		background: var(--blue);
	}

	.visual-orbit i:nth-child(3) {
		bottom: 20%;
		left: -4%;
		background: var(--orange);
	}

	.visual-orbit strong {
		z-index: 1;
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: clamp(2rem, 5vw, 4rem);
	}

	.visual-orbit.alternate {
		border-radius: 0;
		transform: rotate(45deg);
	}

	.visual-orbit.alternate::before,
	.visual-orbit.alternate::after {
		border-radius: 0;
	}

	.visual-orbit.alternate strong {
		transform: rotate(-45deg);
	}

	.project-copy {
		padding: 1.3rem;
		border-top: 1px solid var(--line);
	}

	.project-copy h3 {
		margin: 0;
		font-size: clamp(1.5rem, 2.5vw, 2.5rem);
		font-weight: 560;
		letter-spacing: -0.04em;
	}

