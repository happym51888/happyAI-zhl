		margin: 0.7rem 0 1.2rem;
		color: var(--muted);
		font-size: 0.85rem;
	}

	.project-copy a {
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.67rem;
		text-decoration: none;
		text-transform: uppercase;
	}

	.project-copy a span {
		margin-left: 0.5rem;
		color: var(--acid);
	}

	.works-heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(260px, 0.45fr);
		gap: 2rem;
		align-items: end;
	}

	.works-heading .terminal-heading {
		grid-column: 1 / -1;
		margin-bottom: 0;
	}

	.works-heading > p:last-child {
		margin: 0;
		color: var(--muted);
		font-size: 0.82rem;
	}

	.works-shell {
		grid-column: 2;
		min-width: 0;
		margin-top: 1.5rem;
		border: 1px solid var(--line-strong);
		background: var(--surface);
	}

	.works-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.7rem 0.8rem;
		border-bottom: 1px solid var(--line);
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.57rem;
	}

	.works-toolbar > div {
		display: flex;
		gap: 0.35rem;
	}

	.canvas-control {
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		padding: 0;
		border: 1px solid var(--line);
		background: transparent;
		color: var(--ink);
		cursor: pointer;
	}

	.canvas-control:hover {
		border-color: var(--acid);
		color: var(--acid);
	}

	.works-viewport {
		overflow-x: auto;
		cursor: grab;
		scrollbar-color: var(--line-strong) var(--surface);
		scrollbar-width: thin;
		user-select: none;
	}

	.works-viewport.is-dragging {
		cursor: grabbing;
	}

	.works-track {
		display: grid;
		width: max-content;
		grid-template-columns: repeat(4, minmax(340px, 31vw));
		gap: 1rem;
		padding: 1rem;
	}

	.work-card {
		--work-accent: var(--blue);
		display: grid;
		min-height: 590px;
		grid-template-rows: 1.15fr auto;
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--surface-raised);
	}

	.work-card.tone-violet {
		--work-accent: #b798ff;
	}

	.work-card.tone-lime {
		--work-accent: var(--acid);
	}

	.work-card.tone-orange {
		--work-accent: var(--orange);
	}

	.work-card.tone-blue {
		--work-accent: var(--blue);
	}

	.work-visual {
		position: relative;
		display: grid;
		min-height: 330px;
		place-items: center;
		overflow: hidden;
		background:
			radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--work-accent) 22%, transparent), transparent 52%),
			linear-gradient(var(--grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid) 1px, transparent 1px), var(--surface);
		background-size: auto, 22px 22px, 22px 22px;
	}

	.work-visual > span {
		position: absolute;
		top: 1rem;
		left: 1rem;
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.58rem;
	}

	.work-visual strong {
		z-index: 1;
		max-width: 80%;
		color: var(--work-accent);
		font-family: "Arial Black", Impact, sans-serif;
		font-size: clamp(2.2rem, 5vw, 5rem);
		letter-spacing: -0.08em;
		line-height: 0.82;
		text-align: center;
	}

	.work-visual i {
		position: absolute;
		width: 42%;
		aspect-ratio: 1;
		border: 1px solid color-mix(in srgb, var(--work-accent) 60%, transparent);
		border-radius: 50%;
	}

	.work-visual i:nth-of-type(1) {
		transform: translateX(-44%);
	}

	.work-visual i:nth-of-type(2) {
		transform: translateX(44%);
	}

	.work-visual i:nth-of-type(3) {
		width: 62%;
		border-style: dashed;
		animation: work-spin 22s linear infinite;
	}

	@keyframes work-spin {
		to {
			transform: rotate(360deg);
		}
	}

	.work-copy {
		padding: 1.25rem;
		border-top: 1px solid var(--line);
	}

	.work-copy > div {
		display: flex;
		justify-content: space-between;
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.56rem;
	}

	.work-copy > div b {
		color: var(--work-accent);
		font-size: inherit;
	}

	.work-copy h3 {
		margin: 1.1rem 0 0;
		font-size: clamp(1.5rem, 2.3vw, 2.4rem);
		letter-spacing: -0.045em;
	}

	.work-copy p {
		margin: 0.65rem 0 1.25rem;
		color: var(--muted);
		font-size: 0.82rem;
	}

	.work-copy a {
		color: var(--ink);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.66rem;
		text-decoration: none;
	}

	.work-copy a span {
		margin-left: 0.5rem;
		color: var(--work-accent);
