	.map-nodes b,
	.map-nodes strong {
		min-width: 8rem;
		padding: 0.7rem 0.8rem;
		border: 1px solid var(--line);
		font-size: 0.75rem;
		font-weight: 550;
		text-align: center;
	}

	.map-nodes strong {
		border-color: var(--acid);
		color: var(--acid);
		font-size: 1rem;
	}

	.map-nodes i {
		color: var(--muted);
		font-style: normal;
	}

	.map-connector {
		padding: 0.4rem 0 0.4rem 7rem;
		color: var(--muted);
		text-align: center;
	}

