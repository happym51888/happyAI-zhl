		display: flex;
		justify-content: space-between;
		padding: 0.7rem 0;
		border-bottom: 1px solid var(--line);
		color: var(--muted);
		text-decoration: none;
	}

	.contact-terminal a:hover {
		color: var(--ink);
	}

	.contact-terminal a b {
		color: var(--acid);
	}

	.contact-terminal blockquote,
	.contact-terminal small {
		color: var(--muted);
