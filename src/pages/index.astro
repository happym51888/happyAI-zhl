		display: flex;
		justify-content: space-between;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--line);
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.67rem;
		text-decoration: none;
		text-transform: uppercase;
