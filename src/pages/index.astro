---
const learningAreas = [
	{
		index: '01',
		title: 'Understand',
		subtitle: 'LLM fundamentals',
		description: '理解 Token、上下文、Prompt、结构化输出，以及模型能力的真正边界。',
		href: '/llm/',
		tags: ['LLM', 'Prompt', 'Tool Calling'],
	},
	{
		index: '02',
		title: 'Connect',
		subtitle: 'Knowledge with RAG',
		description: '把个人资料变成模型可以检索、引用和验证的外部知识。',
		href: '/rag/',
		tags: ['Embedding', 'Retrieval', 'Reranking'],
	},
	{
		index: '03',
		title: 'Build',
		subtitle: 'Useful AI agents',
		description: '让模型在可控循环中规划、使用工具、观察结果并完成人类目标。',
		href: '/agent/',
		tags: ['Agent', 'State', 'Human-in-loop'],
	},
];

const notes = [
	{
		number: '001',
		title: 'AI Agent 学习路线',
		description: '从 Python、LLM 和 RAG，一步步走到 Agent 工程化。',
		href: '/learning-path/',
		type: 'ROADMAP',
	},
	{
		number: '002',
		title: 'AI 全景概览',
		description: '把模型、知识、工具、框架和治理连接成一张图。',
		href: '/ai-basics/',
		type: 'OVERVIEW',
	},
	{
		number: '003',
		title: 'LangChain 与 LangGraph',
		description: '两个框架分别解决什么问题，以及什么时候应该使用。',
		href: '/frameworks/',
		type: 'FRAMEWORK',
	},
	{
		number: '004',
		title: '评估、追踪与安全',
		description: '从能运行的 Demo，走向可以可靠投入使用的 AI 系统。',
		href: '/production/',
		type: 'ENGINEERING',
	},
];

const projects = [
	{
		status: 'LIVE',
		title: 'AI Agent Whole Picture',
		description: '一张可以点击探索的知识关系图，解释 LLM、RAG、Agent 与工程治理如何协作。',
		href: '/projects/ai-agent-whole-picture/',
		linkLabel: 'Explore map',
	},
	{
		status: 'BUILDING',
		title: 'HappyAI Knowledge System',
		description: '持续整理学习路径、概念笔记和实践项目，让输入真正沉淀成自己的知识系统。',
		href: '/notes/',
		linkLabel: 'Open notes',
	},
];
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Happy 的个人 AI 网站：记录 LLM、RAG、AI Agent 的学习、思考与实践。"
		/>
		<meta name="theme-color" content="#0b0e13" />
		<meta property="og:title" content="HappyAI · ZHL" />
		<meta
			property="og:description"
			content="Learning AI, one system at a time. Happy 的 AI 学习与实践。"
		/>
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://happy-ai-zhl.vercel.app/" />
		<link rel="canonical" href="https://happy-ai-zhl.vercel.app/" />
		<link rel="icon" href="/favicon.svg" />
		<title>HappyAI · ZHL — Learning AI, one system at a time</title>
		<script is:inline>
			(() => {
				try {
					const saved = localStorage.getItem('happyai-theme');
					document.documentElement.dataset.theme = saved || 'dark';
				} catch {
					document.documentElement.dataset.theme = 'dark';
				}
			})();
		</script>
	</head>

	<body>
		<a class="skip-link" href="#main">跳到主要内容</a>

		<header class="site-header">
			<a class="brand" href="/" aria-label="HappyAI 首页">
				<span class="brand-mark">H</span>
				<span class="brand-copy">
					<strong>HappyAI</strong>
					<small>ZHL / PERSONAL OS</small>
				</span>
			</a>

			<nav class="desktop-nav" aria-label="主导航">
				<a href="#about">About</a>
				<a href="#learning">Learning</a>
				<a href="#projects">Projects</a>
				<a href="/notes/">Notes</a>
			</nav>

			<div class="header-actions">
				<button class="theme-toggle" id="themeToggle" type="button" aria-label="切换颜色主题">
					<span class="theme-dark">LIGHT</span>
					<span class="theme-light">DARK</span>
				</button>
				<button
					class="menu-toggle"
					id="menuToggle"
					type="button"
					aria-label="打开导航菜单"
					aria-expanded="false"
					aria-controls="mobileNav"
				>
					<span></span><span></span>
				</button>
			</div>

			<nav class="mobile-nav" id="mobileNav" aria-label="移动端导航" hidden>
				<a href="#about">About</a>
				<a href="#learning">Learning</a>
				<a href="#projects">Projects</a>
				<a href="/notes/">Notes</a>
			</nav>
		</header>

		<main id="main">
			<section class="hero">
				<div class="hero-grid">
					<div class="hero-copy reveal">
						<p class="terminal-line">
							<span>happy@ai-lab ~ %</span>
							<span class="command">whoami</span>
							<i aria-hidden="true"></i>
						</p>
						<p class="hero-kicker">PERSONAL AI LEARNING SYSTEM / 2026</p>
						<h1>
							Hi, I’m Happy.
							<span>I learn AI by building.</span>
						</h1>
						<p class="hero-intro">
							我正在把对 LLM、RAG 和 AI Agent 的学习，整理成清晰的知识、可以运行的项目，
							以及一套不断进化的个人系统。
						</p>
						<div class="hero-actions">
							<a class="primary-button" href="/learning-path/">
								<span>Start exploring</span>
								<b aria-hidden="true">↗</b>
							</a>
							<a class="text-link" href="/notes/">
								Open knowledge base
								<span aria-hidden="true">→</span>
							</a>
						</div>
						<ul class="hero-meta" aria-label="个人信息摘要">
							<li><span>FOCUS</span> AI AGENT</li>
							<li><span>MODE</span> LEARNING IN PUBLIC</li>
							<li><span>STATUS</span> BUILDING</li>
						</ul>
					</div>

					<aside class="portrait-panel reveal" aria-label="头像预留区域">
						<div class="portrait-topline">
							<span>PORTRAIT.SLOT</span>
							<span>01 / 01</span>
						</div>
						<div class="portrait-placeholder">
							<div class="portrait-frame">
								<span class="corner top-left"></span>
								<span class="corner top-right"></span>
								<span class="corner bottom-left"></span>
								<span class="corner bottom-right"></span>
								<div class="portrait-message">
									<small>PHOTO</small>
									<strong>COMING<br />SOON</strong>
									<p>为你的个人照片预留</p>
								</div>
							</div>
						</div>
						<div class="portrait-caption">
							<span>HAPPY / ZHL</span>
							<span>HUMAN × AI</span>
						</div>
					</aside>
				</div>

				<div class="concept-ticker" aria-hidden="true">
					<div>
						<span>LLM</span><i>✦</i><span>RAG</span><i>✦</i><span>AGENT</span><i>✦</i
						><span>LANGGRAPH</span><i>✦</i><span>EVALUATION</span><i>✦</i
						><span>HUMAN-IN-THE-LOOP</span><i>✦</i><span>BUILD · LEARN · SHARE</span>
					</div>
				</div>
			</section>

			<section class="about section-shell" id="about">
				<div class="section-label reveal">
					<span>01</span>
					<p>ABOUT / NOW</p>
				</div>
				<div class="about-content reveal">
					<p class="terminal-heading">
						<span>happy@ai-lab ~ %</span> cat about.md
					</p>
					<h2>
						我不只是收藏知识，
						<span>我想把它们连接起来。</span>
					</h2>
					<div class="about-columns">
						<p>
							这个网站是我的 AI 学习现场。每理解一个概念，我会尝试用一句话解释它；
							每完成一个项目，我会记录它为什么有效、哪里失败，以及下一次如何做得更好。
						</p>
						<div class="now-list">
							<div><span>NOW.01</span><b>建立 AI Agent whole picture</b></div>
							<div><span>NOW.02</span><b>学习 RAG 与工具调用</b></div>
							<div><span>NOW.03</span><b>把知识变成可复用项目</b></div>
						</div>
					</div>
				</div>
			</section>

			<section class="learning section-shell" id="learning">
				<div class="section-label reveal">
					<span>02</span>
					<p>LEARNING SYSTEM</p>
				</div>
				<div class="section-intro reveal">
					<p class="terminal-heading"><span>ls</span> learning/</p>
					<h2>Understand. Connect. Build.</h2>
					<p>从基本原理出发，再使用框架；从一个可靠的单 Agent 出发，再考虑复杂系统。</p>
				</div>

				<div class="learning-grid">
					{
						learningAreas.map((area) => (
							<a class="learning-card reveal" href={area.href}>
								<div class="card-index">{area.index}</div>
								<div>
									<p>{area.subtitle}</p>
									<h3>{area.title}</h3>
									<span>{area.description}</span>
								</div>
								<ul>
									{area.tags.map((tag) => <li>{tag}</li>)}
								</ul>
								<b class="card-arrow" aria-hidden="true">↗</b>
							</a>
						))
					}
				</div>
			</section>

			<section class="map-section section-shell">
				<div class="section-label reveal">
					<span>03</span>
					<p>KNOWLEDGE MAP</p>
				</div>
				<div class="map-header reveal">
					<div>
						<p class="terminal-heading"><span>open</span> whole-picture.map</p>
						<h2>AI Agent，不只是一个聊天框。</h2>
					</div>
					<a href="/projects/ai-agent-whole-picture/">View full map <span>↗</span></a>
				</div>

				<div class="system-map reveal">
					<div class="map-row">
						<span class="row-label">INPUT</span>
						<div class="map-nodes">
							<b>Python App</b><i>→</i><b>HTTP API</b><i>→</i><b>Prompt</b>
						</div>
					</div>
					<div class="map-connector">↓</div>
					<div class="map-row core-row">
						<span class="row-label">BRAIN</span>
						<div class="map-nodes">
							<b>Context</b><i>→</i><strong>LLM</strong><i>→</i><b>Tool Calling</b>
						</div>
					</div>
					<div class="map-connector split-connector">↙ &nbsp;&nbsp;&nbsp; ↓ &nbsp;&nbsp;&nbsp; ↘</div>
					<div class="map-columns">
						<div><span>KNOWLEDGE</span><b>RAG</b><small>Retrieve evidence</small></div>
						<div><span>CONTROL</span><b>Agent</b><small>Plan and observe</small></div>
						<div><span>ACTION</span><b>Tools</b><small>Change the world</small></div>
					</div>
					<div class="map-foundation">
						<span>Evaluation</span><span>Tracing</span><span>Cost</span><span>Permission</span
						><span>Security</span>
					</div>
				</div>
			</section>

			<section class="notes section-shell" id="notes">
				<div class="section-label reveal">
					<span>04</span>
					<p>LATEST NOTES</p>
				</div>
				<div class="notes-header reveal">
					<div>
						<p class="terminal-heading"><span>find</span> notes/ -type f</p>
						<h2>正在生长的知识库</h2>
					</div>
					<a href="/notes/">All notes <span>→</span></a>
				</div>
				<div class="notes-list">
					{
						notes.map((note) => (
							<a class="note-row reveal" href={note.href}>
								<span class="note-number">{note.number}</span>
								<div>
									<p>{note.type}</p>
									<h3>{note.title}</h3>
								</div>
								<p class="note-description">{note.description}</p>
								<b aria-hidden="true">↗</b>
							</a>
						))
					}
				</div>
			</section>

			<section class="projects section-shell" id="projects">
				<div class="section-label reveal">
					<span>05</span>
					<p>PROJECTS</p>
				</div>
				<div class="projects-heading reveal">
					<p class="terminal-heading"><span>ls</span> projects/</p>
					<h2>Learning through making.</h2>
				</div>
				<div class="project-grid">
					{
						projects.map((project, index) => (
							<article class="project-card reveal">
								<div class="project-meta">
									<span>PROJECT_{String(index + 1).padStart(2, '0')}</span>
									<b>{project.status}</b>
								</div>
								<div class="project-visual" aria-hidden="true">
									<div class:list={['visual-orbit', { alternate: index === 1 }]}>
										<i></i><i></i><i></i><strong>{index === 0 ? 'AI' : 'H'}</strong>
									</div>
								</div>
								<div class="project-copy">
									<h3>{project.title}</h3>
									<p>{project.description}</p>
									<a href={project.href}>{project.linkLabel} <span>↗</span></a>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<section class="closing">
				<div class="closing-copy reveal">
					<p class="terminal-heading"><span>happy@ai-lab ~ %</span> echo $NEXT</p>
					<h2>Stay curious.<br />Keep building.</h2>
					<p>这个网站会随着我的学习持续更新。</p>
				</div>
				<div class="closing-links reveal">
					<a href="/notes/">进入 AI 知识库 <span>↗</span></a>
					<a href="https://github.com/happym51888/happyAI-zhl" rel="noreferrer">
						GitHub repository <span>↗</span>
					</a>
				</div>
			</section>
		</main>

		<footer>
			<div>
				<span>HAPPYAI · ZHL</span>
				<span>PERSONAL AI LEARNING SYSTEM</span>
			</div>
			<p>© <span id="year">2026</span> Happy · Built by learning in public.</p>
		</footer>

		<script>
			const root = document.documentElement;
			const themeToggle = document.querySelector('#themeToggle');
			const menuToggle = document.querySelector('#menuToggle');
			const mobileNav = document.querySelector('#mobileNav');
			const year = document.querySelector('#year');

			themeToggle?.addEventListener('click', () => {
				const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
				root.dataset.theme = nextTheme;
				localStorage.setItem('happyai-theme', nextTheme);
			});

			menuToggle?.addEventListener('click', () => {
				const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
				menuToggle.setAttribute('aria-expanded', String(!isOpen));
				if (mobileNav instanceof HTMLElement) mobileNav.hidden = isOpen;
			});

			mobileNav?.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => {
					menuToggle?.setAttribute('aria-expanded', 'false');
					if (mobileNav instanceof HTMLElement) mobileNav.hidden = true;
				});
			});

			if (year) year.textContent = String(new Date().getFullYear());

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.12 },
			);

			document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
		</script>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		--bg: #0b0e13;
		--surface: #11161e;
		--surface-raised: #171d26;
		--ink: #f3f0e8;
		--muted: #969eaa;
		--line: #29313c;
		--line-strong: #46515f;
		--acid: #c7f85d;
		--blue: #78b7ff;
		--orange: #ff9c66;
		--terminal: #87e9be;
		--grid: rgba(255, 255, 255, 0.035);
		--header: rgba(11, 14, 19, 0.86);
		--shadow: none;
		font-family:
			Inter, "Segoe UI", "Microsoft YaHei", system-ui, -apple-system, BlinkMacSystemFont,
			sans-serif;
	}

	:root[data-theme='light'] {
		color-scheme: light;
		--bg: #f2efe8;
		--surface: #faf8f2;
		--surface-raised: #ffffff;
		--ink: #15181d;
		--muted: #606873;
		--line: #d3d0c8;
		--line-strong: #9ba1aa;
		--acid: #577d00;
		--blue: #1e65b5;
		--orange: #b64d16;
		--terminal: #14734f;
		--grid: rgba(20, 25, 32, 0.045);
		--header: rgba(242, 239, 232, 0.9);
		--shadow: 0 20px 50px rgba(38, 42, 50, 0.08);
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		background: var(--bg);
	}

	body {
		margin: 0;
		background:
			linear-gradient(var(--grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid) 1px, transparent 1px), var(--bg);
		background-size: 32px 32px;
		color: var(--ink);
		line-height: 1.6;
		transition: background-color 180ms ease, color 180ms ease;
	}

	button,
	a {
		font: inherit;
	}

	a {
		color: inherit;
	}

	.skip-link {
		position: fixed;
		z-index: 100;
		top: 0.75rem;
		left: 0.75rem;
		padding: 0.65rem 0.9rem;
		background: var(--acid);
		color: var(--bg);
		transform: translateY(-160%);
		transition: transform 120ms ease;
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	.site-header {
		position: sticky;
		z-index: 50;
		top: 0;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		min-height: 76px;
		padding: 0 4vw;
		border-bottom: 1px solid var(--line);
		background: var(--header);
		backdrop-filter: blur(18px);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		justify-self: start;
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		width: 2.25rem;
		height: 2.25rem;
		place-items: center;
		border: 1px solid var(--line-strong);
		background: var(--ink);
		color: var(--bg);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.92rem;
		font-weight: 800;
	}

	.brand-copy {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}

	.brand-copy strong {
		font-size: 0.87rem;
		letter-spacing: 0.03em;
	}

	.brand-copy small {
		margin-top: 0.2rem;
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.58rem;
		letter-spacing: 0.11em;
	}

	.desktop-nav {
		display: flex;
		gap: 2rem;
		justify-self: center;
	}

	.desktop-nav a {
		position: relative;
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.desktop-nav a::after {
		position: absolute;
		right: 0;
		bottom: -0.5rem;
		left: 0;
		height: 1px;
		background: var(--acid);
		content: "";
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 150ms ease;
	}

	.desktop-nav a:hover {
		color: var(--ink);
	}

	.desktop-nav a:hover::after {
		transform: scaleX(1);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		justify-self: end;
	}

	.theme-toggle,
	.menu-toggle {
		border: 1px solid var(--line);
		background: transparent;
		color: var(--muted);
		cursor: pointer;
	}

	.theme-toggle {
		min-width: 4.4rem;
		padding: 0.48rem 0.65rem;
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.61rem;
		letter-spacing: 0.08em;
	}

	.theme-light,
	:root[data-theme='light'] .theme-dark {
		display: none;
	}

	:root[data-theme='light'] .theme-light {
		display: inline;
	}

	.menu-toggle {
		display: none;
		width: 2.35rem;
		height: 2.35rem;
		padding: 0.65rem;
	}

	.menu-toggle span {
		display: block;
		height: 1px;
		margin: 0.3rem 0;
		background: currentColor;
	}

	.mobile-nav {
		position: absolute;
		top: 100%;
		right: 0;
		left: 0;
		padding: 1rem 4vw 1.4rem;
		border-bottom: 1px solid var(--line);
		background: var(--surface);
	}

	.mobile-nav a {
		display: block;
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--line);
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		text-decoration: none;
		text-transform: uppercase;
	}

	.hero {
		min-height: calc(100svh - 76px);
		padding: 5.5vw 4vw 0;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
		gap: clamp(2rem, 7vw, 8rem);
		align-items: center;
		width: min(1440px, 100%);
		min-height: 68vh;
		margin: 0 auto;
	}

	.terminal-line,
	.terminal-heading {
		margin: 0 0 1.75rem;
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.02em;
	}

	.terminal-line span:first-child,
	.terminal-heading span {
		color: var(--terminal);
	}

	.terminal-line .command {
		margin-left: 0.6rem;
		color: var(--ink);
	}

	.terminal-line i {
		display: inline-block;
		width: 0.48rem;
		height: 1em;
		margin-left: 0.3rem;
		background: var(--acid);
		vertical-align: -0.12em;
		animation: blink 1.1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.hero-kicker {
		margin: 0 0 1rem;
		color: var(--acid);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.67rem;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.hero h1 {
		max-width: 950px;
		margin: 0;
		font-size: clamp(3.4rem, 7.4vw, 8.2rem);
		font-weight: 680;
		letter-spacing: -0.075em;
		line-height: 0.91;
	}

	.hero h1 span {
		display: block;
		color: var(--muted);
		font-weight: 430;
	}

	.hero-intro {
		max-width: 680px;
		margin: 2rem 0 0;
		color: var(--muted);
		font-size: clamp(1rem, 1.4vw, 1.2rem);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		align-items: center;
		margin-top: 2.2rem;
	}

	.primary-button {
		display: inline-flex;
		min-width: 12.5rem;
		align-items: center;
		justify-content: space-between;
		padding: 0.9rem 1rem;
		background: var(--acid);
		color: #11150b;
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.75rem;
		font-weight: 700;
		text-decoration: none;
		text-transform: uppercase;
		transition: transform 130ms ease;
	}

	.primary-button:hover {
		transform: translateY(-3px);
	}

	.text-link {
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.72rem;
		text-decoration: none;
	}

	.text-link span {
		margin-left: 0.5rem;
		color: var(--ink);
	}

	.text-link:hover {
		color: var(--ink);
	}

	.hero-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		margin: 3rem 0 0;
		padding: 0;
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.62rem;
		list-style: none;
	}

	.hero-meta span {
		margin-right: 0.35rem;
		color: var(--blue);
	}

	.portrait-panel {
		width: min(100%, 420px);
		justify-self: end;
		border: 1px solid var(--line);
		background: var(--surface);
		box-shadow: var(--shadow);
	}

	.portrait-topline,
	.portrait-caption {
		display: flex;
		justify-content: space-between;
		padding: 0.72rem 0.85rem;
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.57rem;
		letter-spacing: 0.08em;
	}

	.portrait-topline {
		border-bottom: 1px solid var(--line);
	}

	.portrait-caption {
		border-top: 1px solid var(--line);
	}

	.portrait-placeholder {
		padding: 1rem;
	}

	.portrait-frame {
		position: relative;
		display: grid;
		aspect-ratio: 4 / 5;
		place-items: center;
		overflow: hidden;
		background:
			linear-gradient(135deg, transparent 49.5%, var(--line) 50%, transparent 50.5%),
			linear-gradient(45deg, transparent 49.5%, var(--line) 50%, transparent 50.5%),
			repeating-linear-gradient(0deg, transparent 0 30px, var(--grid) 30px 31px),
			var(--surface-raised);
	}

	.portrait-frame::after {
		position: absolute;
		width: 64%;
		aspect-ratio: 1;
		border: 1px solid var(--line);
		border-radius: 50%;
		content: "";
	}

	.portrait-message {
		z-index: 1;
		padding: 1.1rem;
		background: var(--surface);
		text-align: center;
	}

	.portrait-message small {
		color: var(--acid);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.58rem;
		letter-spacing: 0.2em;
	}

	.portrait-message strong {
		display: block;
		margin-top: 0.6rem;
		font-size: clamp(1.6rem, 3vw, 2.6rem);
		letter-spacing: -0.05em;
		line-height: 0.9;
	}

	.portrait-message p {
		margin: 0.75rem 0 0;
		color: var(--muted);
		font-size: 0.68rem;
	}

	.corner {
		position: absolute;
		z-index: 2;
		width: 1.15rem;
		height: 1.15rem;
		border-color: var(--acid);
	}

	.top-left {
		top: 0;
		left: 0;
		border-top: 2px solid;
		border-left: 2px solid;
	}

	.top-right {
		top: 0;
		right: 0;
		border-top: 2px solid;
		border-right: 2px solid;
	}

	.bottom-left {
		bottom: 0;
		left: 0;
		border-bottom: 2px solid;
		border-left: 2px solid;
	}

	.bottom-right {
		right: 0;
		bottom: 0;
		border-right: 2px solid;
		border-bottom: 2px solid;
	}

	.concept-ticker {
		width: calc(100% + 8vw);
		margin: 4vw -4vw 0;
		overflow: hidden;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		background: var(--surface);
	}

	.concept-ticker div {
		display: flex;
		width: max-content;
		gap: 1.5rem;
		padding: 0.9rem 0;
		align-items: center;
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.67rem;
		letter-spacing: 0.12em;
		animation: ticker 26s linear infinite alternate;
	}

	.concept-ticker i {
		color: var(--acid);
		font-style: normal;
	}

	@keyframes ticker {
		to {
			transform: translateX(min(-34%, -420px));
		}
	}

	.section-shell {
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 7rem);
		width: min(1440px, calc(100% - 8vw));
		margin: 0 auto;
		padding: clamp(6rem, 10vw, 11rem) 0;
		border-bottom: 1px solid var(--line);
		scroll-margin-top: 5rem;
	}

	.section-label {
		align-self: start;
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
	}

	.section-label span {
		display: block;
		margin-bottom: 0.75rem;
		color: var(--acid);
		font-size: 0.68rem;
	}

	.section-label p {
		margin: 0;
		font-size: 0.63rem;
		letter-spacing: 0.12em;
		writing-mode: vertical-rl;
	}

	.about-content h2,
	.section-intro h2,
	.map-header h2,
	.notes-header h2,
	.projects-heading h2 {
		max-width: 1040px;
		margin: 0;
		font-size: clamp(2.5rem, 5.2vw, 6rem);
		font-weight: 560;
		letter-spacing: -0.06em;
		line-height: 0.98;
	}

	.about-content h2 span {
		display: block;
		color: var(--muted);
	}

	.about-columns {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(290px, 0.75fr);
		gap: clamp(2rem, 6vw, 7rem);
		margin-top: 3.5rem;
	}

	.about-columns > p {
		max-width: 720px;
		margin: 0;
		color: var(--muted);
		font-size: clamp(1rem, 1.5vw, 1.25rem);
	}

	.now-list {
		border-top: 1px solid var(--line);
	}

	.now-list div {
		display: grid;
		grid-template-columns: 5.4rem 1fr;
		gap: 1rem;
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--line);
	}

	.now-list span {
		color: var(--blue);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.6rem;
	}

	.now-list b {
		font-size: 0.86rem;
		font-weight: 550;
	}

	.section-intro > p:last-child {
		max-width: 660px;
		margin: 1.5rem 0 0;
		color: var(--muted);
	}

	.learning-grid {
		grid-column: 2;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-top: 1.2rem;
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line);
	}

	.learning-card {
		position: relative;
		display: flex;
		min-height: 430px;
		flex-direction: column;
		padding: 1.5rem;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		background: var(--surface);
		text-decoration: none;
		transition: background-color 150ms ease;
	}

	.learning-card:hover {
		background: var(--surface-raised);
	}

	.card-index {
		color: var(--acid);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.64rem;
	}

	.learning-card > div:nth-child(2) {
		margin-top: auto;
	}

	.learning-card p {
		margin: 0 0 0.35rem;
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.62rem;
		text-transform: uppercase;
	}

	.learning-card h3 {
		margin: 0;
		font-size: clamp(2rem, 3.1vw, 3.5rem);
		font-weight: 560;
		letter-spacing: -0.055em;
	}

	.learning-card div > span {
		display: block;
		margin-top: 1rem;
		color: var(--muted);
		font-size: 0.86rem;
	}

	.learning-card ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.learning-card li {
		padding: 0.25rem 0.45rem;
		border: 1px solid var(--line);
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.55rem;
	}

	.card-arrow {
		position: absolute;
		top: 1.25rem;
		right: 1.25rem;
		font-weight: 400;
	}

	.map-header,
	.notes-header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
	}

	.map-header > a,
	.notes-header > a {
		flex: 0 0 auto;
		padding-bottom: 0.35rem;
		border-bottom: 1px solid var(--line-strong);
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.67rem;
		text-decoration: none;
		text-transform: uppercase;
	}

	.map-header > a span,
	.notes-header > a span {
		margin-left: 0.5rem;
		color: var(--acid);
	}

	.system-map {
		grid-column: 2;
		margin-top: 1.5rem;
		padding: clamp(1.2rem, 3vw, 3rem);
		border: 1px solid var(--line);
		background: var(--surface);
	}

	.map-row {
		display: grid;
		grid-template-columns: 6rem minmax(0, 1fr);
		gap: 1rem;
		align-items: center;
	}

	.row-label {
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.58rem;
		letter-spacing: 0.1em;
	}

	.map-nodes {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(0.45rem, 1.5vw, 1.2rem);
	}

	.map-nodes b,
	.map-nodes strong {
		min-width: 8rem;
		padding: 0.7rem 0.8rem;
		border: 1px solid var(--line);
		font-size: 0.75rem;
		font-weight: 550;
		text-align: center;
	}

	.map-nodes strong {
		border-color: var(--acid);
		color: var(--acid);
		font-size: 1rem;
	}

	.map-nodes i {
		color: var(--muted);
		font-style: normal;
	}

	.map-connector {
		padding: 0.4rem 0 0.4rem 7rem;
		color: var(--muted);
		text-align: center;
	}

	.split-connector {
		color: var(--blue);
	}

	.map-columns {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
		margin-left: 7rem;
	}

	.map-columns div {
		display: flex;
		min-height: 8rem;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		border: 1px solid var(--line);
		background: var(--surface-raised);
		text-align: center;
	}

	.map-columns span {
		color: var(--blue);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.55rem;
		letter-spacing: 0.1em;
	}

	.map-columns b {
		margin: 0.4rem 0 0.2rem;
		font-size: 1.5rem;
	}

	.map-columns small {
		color: var(--muted);
	}

	.map-foundation {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
		margin: 1.25rem 0 0 7rem;
		padding-top: 1.25rem;
		border-top: 1px dashed var(--line-strong);
	}

	.map-foundation span {
		padding: 0.32rem 0.55rem;
		border: 1px solid var(--line);
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.57rem;
	}

	.notes-list {
		grid-column: 2;
		margin-top: 1.5rem;
		border-top: 1px solid var(--line);
	}

	.note-row {
		display: grid;
		grid-template-columns: 4rem minmax(200px, 0.8fr) minmax(260px, 1.2fr) auto;
		gap: 1.5rem;
		align-items: center;
		padding: 1.3rem 0;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
		transition: padding 150ms ease, background-color 150ms ease;
	}

	.note-row:hover {
		padding-inline: 0.85rem;
		background: var(--surface);
	}

	.note-number,
	.note-row div p {
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.58rem;
	}

	.note-row div p {
		margin: 0 0 0.25rem;
		color: var(--blue);
		letter-spacing: 0.08em;
	}

	.note-row h3 {
		margin: 0;
		font-size: clamp(1.15rem, 1.7vw, 1.6rem);
		font-weight: 560;
	}

	.note-description {
		margin: 0;
		color: var(--muted);
		font-size: 0.84rem;
	}

	.note-row > b {
		font-weight: 400;
	}

	.projects-heading {
		margin-bottom: 1.5rem;
	}

	.project-grid {
		grid-column: 2;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.project-card {
		display: grid;
		min-height: 570px;
		grid-template-rows: auto 1fr auto;
		border: 1px solid var(--line);
		background: var(--surface);
	}

	.project-meta {
		display: flex;
		justify-content: space-between;
		padding: 0.9rem 1rem;
		border-bottom: 1px solid var(--line);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.58rem;
	}

	.project-meta span {
		color: var(--muted);
	}

	.project-meta b {
		color: var(--acid);
	}

	.project-visual {
		display: grid;
		min-height: 300px;
		place-items: center;
		overflow: hidden;
		background:
			linear-gradient(var(--grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid) 1px, transparent 1px), var(--surface-raised);
		background-size: 24px 24px;
	}

	.visual-orbit {
		position: relative;
		display: grid;
		width: min(52%, 220px);
		aspect-ratio: 1;
		place-items: center;
		border: 1px solid var(--line-strong);
		border-radius: 50%;
	}

	.visual-orbit::before,
	.visual-orbit::after {
		position: absolute;
		border: 1px solid var(--line);
		border-radius: 50%;
		content: "";
		inset: -18%;
	}

	.visual-orbit::after {
		inset: 18%;
	}

	.visual-orbit i {
		position: absolute;
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--acid);
	}

	.visual-orbit i:nth-child(1) {
		top: -0.3rem;
	}

	.visual-orbit i:nth-child(2) {
		right: 8%;
		bottom: 13%;
		background: var(--blue);
	}

	.visual-orbit i:nth-child(3) {
		bottom: 20%;
		left: -4%;
		background: var(--orange);
	}

	.visual-orbit strong {
		z-index: 1;
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: clamp(2rem, 5vw, 4rem);
	}

	.visual-orbit.alternate {
		border-radius: 0;
		transform: rotate(45deg);
	}

	.visual-orbit.alternate::before,
	.visual-orbit.alternate::after {
		border-radius: 0;
	}

	.visual-orbit.alternate strong {
		transform: rotate(-45deg);
	}

	.project-copy {
		padding: 1.3rem;
		border-top: 1px solid var(--line);
	}

	.project-copy h3 {
		margin: 0;
		font-size: clamp(1.5rem, 2.5vw, 2.5rem);
		font-weight: 560;
		letter-spacing: -0.04em;
	}

	.project-copy p {
		margin: 0.7rem 0 1.2rem;
		color: var(--muted);
		font-size: 0.85rem;
	}

	.project-copy a {
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.67rem;
		text-decoration: none;
		text-transform: uppercase;
	}

	.project-copy a span {
		margin-left: 0.5rem;
		color: var(--acid);
	}

	.closing {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 3rem;
		align-items: end;
		width: min(1440px, calc(100% - 8vw));
		margin: 0 auto;
		padding: clamp(7rem, 12vw, 13rem) 0;
	}

	.closing h2 {
		margin: 0;
		font-size: clamp(3.6rem, 9vw, 10rem);
		font-weight: 560;
		letter-spacing: -0.075em;
		line-height: 0.85;
	}

	.closing-copy > p:last-child {
		margin: 2rem 0 0;
		color: var(--muted);
	}

	.closing-links {
		display: grid;
		gap: 0.65rem;
		min-width: 16rem;
	}

	.closing-links a {
		display: flex;
		justify-content: space-between;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--line);
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.67rem;
		text-decoration: none;
		text-transform: uppercase;
	}

	.closing-links a:hover {
		color: var(--ink);
	}

	.closing-links span {
		color: var(--acid);
	}

	footer {
		display: flex;
		justify-content: space-between;
		gap: 2rem;
		padding: 1.5rem 4vw;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.58rem;
	}

	footer > div {
		display: flex;
		gap: 1.5rem;
	}

	footer p {
		margin: 0;
	}

	.reveal {
		opacity: 0;
		transform: translateY(18px);
		transition: opacity 550ms ease, transform 550ms ease;
	}

	.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (max-width: 980px) {
		.site-header {
			grid-template-columns: 1fr auto;
		}

		.desktop-nav {
			display: none;
		}

		.menu-toggle {
			display: block;
		}

		.hero-grid {
			grid-template-columns: 1fr;
			padding-bottom: 4rem;
		}

		.portrait-panel {
			width: min(100%, 520px);
			justify-self: start;
		}

		.section-shell {
			grid-template-columns: 1fr;
		}

		.section-label {
			display: flex;
			gap: 0.7rem;
			align-items: center;
		}

		.section-label span {
