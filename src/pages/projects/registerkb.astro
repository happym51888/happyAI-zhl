---
import '../../components/case/case.css';
import { withBase } from '../../lib/base';

const title = 'RegisterKB · 团队 AI 工作助手 — Happy OS';
const description =
	'RegisterKB：我带团队做的部门 AI 工作助手。混合检索找证据，LangGraph Agent 生成步骤、人审批后执行，成功经验沉淀成 Skill。约 60 人在用。';
const pageUrl = new URL(withBase('/projects/registerkb/'), Astro.site).href;
const ogImage = new URL(withBase('/images/registerkb/og.jpg'), Astro.site).href;
const img = (name: string) => withBase(`/images/registerkb/${name}.webp`);
const worksHref = withBase('/#works');

const meta = [
	{ label: '角色', value: '团队负责人：架构、核心代码、验收' },
	{ label: '状态', value: '部门内约 60 人在用' },
];

const stack = ['Python', 'LangGraph', 'BM25 + BGE-M3', 'RRF', 'MCP', 'Human-in-the-loop'];

const metrics = [
	{ value: '5000+', unit: '篇', label: '内部文档入库，按页面 ID 去重', tone: 'blue' },
	{ value: '约 2.5 万', unit: '块', label: '证据块，标注模块、版本、可信度', tone: 'yellow' },
	{ value: '95%', unit: 'Top-3', label: '24 条真实问题评测，原来 79.2%', tone: 'pink' },
	{ value: '≈60', unit: '人', label: '部门内在用', tone: 'green' },
];

const pains = [
	{ tone: 'yellow', title: '对的页面难找', body: '几千篇文档，不同版本、不同环境的步骤还不一样。' },
	{ tone: 'pink', title: '文档到命令靠人翻译', body: '示例命令要按当前环境自己改，费时又容易出错。' },
	{ tone: 'blue', title: '装好了，经验也散了', body: '踩过的坑留在个人笔记里，下一个人从头再来。' },
];

const lanes = [
	{ tone: 'blue', label: '证据学习' },
	{ tone: 'yellow', label: '受控执行' },
	{ tone: 'green', label: '经验沉淀' },
];

const steps = [
	{
		id: 'search',
		no: '01',
		tone: 'blue',
		title: '搜索',
		short: '混合检索，返回 3–5 个带出处的来源',
		detail: [
			'在 Cursor 或网页里说一句“testclient 怎么装”。',
			'BM25 负责精确匹配命令和错误码，BGE-M3 向量负责匹配换了说法的问题，两路用 RRF 融合。',
			'返回原文片段和出处链接，并标出有没有可复用的 Skill。',
		],
		rule: '这一步只检索、只总结，不做任何操作。',
	},
	{
		id: 'select',
		no: '02',
		tone: 'blue',
		title: '选择证据',
		short: '人勾选可信来源，只学被选中的',
		detail: [
			'弹出多选框 C1 / C2 / C3，由人判断哪些页面靠谱。',
			'子页面如果已在本地索引，会跟着一起学。',
			'没索引的链接和附件不硬猜，单独列成“缺口”。',
		],
		rule: '没有人工勾选，就不开始学习。',
	},
	{
		id: 'plan',
		no: '03',
		tone: 'yellow',
		title: '生成计划',
		short: '学到什么、缺什么，再出 runbook',
		detail: [
			'先汇报学到了哪些内容，哪些地方还是空白。',
			'生成 runbook，每一步带 precheck、backup 和 validation。',
			'LangGraph 状态图在审批节点中断，等人确认。',
		],
		rule: '计划没确认，不进入执行。',
	},
	{
		id: 'execute',
		no: '04',
		tone: 'yellow',
		title: '受控执行',
		short: '允许名单 + approval token + 脱敏',
		detail: [
			'每条命令先标 allow 或 block，危险命令直接拦下。',
			'approval token 由目标环境和命令列表算出，人工输入才执行。',
			'出错即停，输出脱敏后写进执行日志。',
		],
		rule: '名单之外的命令一律不跑。',
	},
	{
		id: 'writeback',
		no: '05',
		tone: 'green',
		title: '成功沉淀',
		short: '成功后先挂起，人选了才写回',
		detail: [
			'执行成功后自动生成 Skill 草稿，状态是 pending。',
			'人工审核后选择：写回默认页面 / 不写回 / 写回指定页面。',
			'写回只追加，不覆盖原有内容。',
		],
		rule: 'pending 不会自动发布；失败的执行不会变成 Skill。',
	},
];

const layers = [
	{ tone: 'blue', name: '入口', tech: 'Cursor 对话 · Web UI · CLI', note: '通过 HTTP API 和 MCP 接入 Cursor' },
	{ tone: 'violet', name: '编排', tech: 'LangGraph 状态图', note: '学习来源 → 生成计划 → 人工审批 → SSH 执行 → 写回 Skill' },
	{ tone: 'green', name: '检索', tech: 'BM25 + BGE-M3 + RRF', note: 'SQLite FTS5 精确匹配 · 向量匹配换了说法的问题 · 融合排序' },
	{ tone: 'yellow', name: '执行', tech: 'Remote Executor', note: '允许 / 禁止名单 · approval token · 出错即停 · 输出脱敏' },
	{ tone: 'pink', name: '沉淀', tech: '执行日志 + 写回状态机', note: 'execution_runs · skill_writebacks · 人选了才发布' },
];

const safety = [
	'rm -rf、delete、uninstall、sudo 和命令串联，计划阶段直接拦下',
	'approval token 必须和当前目标、命令完全对得上',
	'密码只在本次会话里用，日志、数据库、Skill 都不存',
	'执行日志全程留痕，出问题能追溯',
];

const termLines = [
	{ kind: 'you', text: '用 RegisterKB 查一下 testclient 怎么装' },
	{ kind: 'kb', text: '找到 4 个候选来源：' },
	{ kind: 'out', text: 'C1  TestClient 安装指南        0.92  ★ 有可复用 skill' },
	{ kind: 'out', text: 'C2  Helm chart 参数说明        0.81' },
	{ kind: 'out', text: 'C3  namespace 与权限准备       0.77' },
	{ kind: 'kb', text: '我只学习你勾选的来源，请选择：' },
	{ kind: 'you', text: 'C1, C3' },
	{ kind: 'kb', text: '已学习 2 个来源；缺口：1 个附件未索引，没有猜它的内容' },
	{ kind: 'kb', text: 'Runbook：precheck → backup → install → validate，等你确认' },
	{ kind: 'you', text: '确认' },
	{ kind: 'kb', text: 'remote-executor-plan' },
	{ kind: 'ok', text: '✓ allow  kubectl get ns testclient' },
	{ kind: 'ok', text: '✓ allow  helm upgrade --install testclient ./chart -n testclient' },
	{ kind: 'block', text: '✗ block  rm -rf /tmp/old-chart    删除类命令' },
	{ kind: 'kb', text: '请输入 approval token：' },
	{ kind: 'you', text: '••••-••••' },
	{ kind: 'kb', text: '执行完成，输出已脱敏写入执行日志' },
	{ kind: 'out', text: 'testclient-7b6f9   1/1   Running   0   2m' },
	{ kind: 'kb', text: '成功 → Skill 草稿已生成（pending）。要写回吗？' },
	{ kind: 'you', text: '1  写回默认页面' },
	{ kind: 'kb', text: '已追加。下次再问，直接复用这份 runbook ✓' },
];

const results = [
	'部门内推广，约 60 人在用',
	'沉淀了一批 Skill，覆盖云平台集群安装部署、特性验证和回归测试',
	'同类任务直接调用 Skill，不用再查资料试错',
	'24 条真实问题评测，Top-3 命中率从 79.2% 提升到 95%',
];

const roadmap = ['Dream 学习日志', 'RBAC 权限', 'Skill Mesh 集成', 'Jira 集成'];

const nav = [
	{ href: '#problem', label: '问题' },
	{ href: '#flow', label: '流程' },
	{ href: '#architecture', label: '架构' },
	{ href: '#demo', label: '演示' },
	{ href: '#results', label: '结果' },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#faf8f2" />
		<meta property="og:title" content="RegisterKB · 团队 AI 工作助手" />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="article" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<link rel="canonical" href={pageUrl} />
		<link rel="icon" href={withBase('/favicon.svg')} />
		<title>{title}</title>
	</head>

	<body class="case-page">
		<header class="case-top">
			<div class="case-wrap">
				<div class="crumbs">
					<a class="back-link" href={worksHref}>← 作品集</a>
					<a class="brand hide-sm" href={withBase('/')}>happy <b>OS</b></a>
					<span class="hide-sm">/ dim_01 /</span>
					<span>RegisterKB</span>
				</div>
				<nav class="case-nav" aria-label="页面目录">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
			</div>
		</header>

		<main class="case-wrap">
			<section class="case-hero">
				<div>
					<p class="eyebrow">dim_01 · 代表作</p>
					<h1>
						RegisterKB
						<small><span class="mark">团队 AI 工作助手</span></small>
					</h1>
					<p class="lead">
						测试环境搭建、工具安装、特性验证的文档有几千篇，照着做费时又容易错。我带团队把它做成一个助手：先找证据，再让人审批执行，跑成功的经验沉淀成
						Skill，下一个人直接复用。
					</p>
					<dl class="meta">
						{
							meta.map((item) => (
								<div>
									<dt>{item.label}</dt>
									<dd>{item.value}</dd>
								</div>
							))
						}
					</dl>
					<ul class="chips">
						{stack.map((tag) => <li>{tag}</li>)}
					</ul>
				</div>
				<figure class="frame tilt">
					<button class="zoom" type="button" data-zoom={img('with-registerkb')} data-alt="把问题交给 RegisterKB 的漫画">
						<img
							src={img('with-registerkb')}
							width="1200"
							height="800"
							alt="漫画：工程师把“testclient 怎么装？”交给 RegisterKB，它按搜索、学习、生成 Runbook、受控执行、沉淀 Skill 五步处理"
						/>
					</button>
					<figcaption>把问题交给 RegisterKB，它按规则一步步处理。</figcaption>
				</figure>
			</section>

			<section class="metrics" aria-label="关键数字">
				{
					metrics.map((item) => (
						<div class:list={['metric', `tone-${item.tone}`]}>
							<strong>
								{item.value}
								<small>{item.unit}</small>
							</strong>
							<span>{item.label}</span>
						</div>
					))
				}
			</section>

			<section class="case-section" id="problem">
				<div class="sec-head">
					<p class="eyebrow">01 · Problem</p>
					<h2>“testclient 怎么装？” 答案通常是一个链接</h2>
				</div>
				<div class="problem">
					<figure class="frame">
						<button class="zoom" type="button" data-zoom={img('before-manual')} data-alt="以前的手动流程">
							<img
								src={img('before-manual')}
								width="1200"
								height="800"
								loading="lazy"
								alt="四格漫画：手动点开链接、一步步学习理解、自己适配命令、在集群上手敲命令"
							/>
						</button>
						<figcaption>以前：点链接 → 读文档 → 改命令 → 上集群手敲。</figcaption>
					</figure>
					<div class="pain-stack">
						{
							pains.map((pain) => (
								<div class:list={['pain', `tone-${pain.tone}`]}>
									<b>{pain.title}</b>
									<p>{pain.body}</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<section class="case-section" id="flow">
				<div class="sec-head">
					<p class="eyebrow">02 · Flow</p>
					<h2>五步闭环：先选证据，再执行；成功后先挂起</h2>
					<p>点击每一步，看它做什么、守什么规矩。</p>
				</div>
				<div class="lanes" aria-hidden="true">
					{
						lanes.map((lane) => (
							<span class={`tone-${lane.tone}`}>
								<i />
								{lane.label}
							</span>
						))
					}
				</div>
				<div class="flow-steps" role="tablist" aria-label="五步流程">
					{
						steps.map((step, index) => (
							<button
								class:list={['flow-step', `tone-${step.tone}`, { 'is-active': index === 0 }]}
								type="button"
								role="tab"
								id={`step-${step.id}`}
								aria-controls={`panel-${step.id}`}
								aria-selected={index === 0 ? 'true' : 'false'}
								data-step={step.id}
							>
								<span class="no">{step.no}</span>
								<b>{step.title}</b>
								<small>{step.short}</small>
							</button>
						))
					}
				</div>
				{
					steps.map((step, index) => (
						<div
							class:list={['flow-panel', `tone-${step.tone}`]}
							role="tabpanel"
							id={`panel-${step.id}`}
							aria-labelledby={`step-${step.id}`}
							data-step-panel={step.id}
							hidden={index !== 0}
						>
							<div>
								<h3>
									{step.no} · {step.title}
								</h3>
								<ul>
									{step.detail.map((line) => (
										<li>{line}</li>
									))}
								</ul>
							</div>
							<p class="rule">
								<span>规矩</span>
								{step.rule}
							</p>
						</div>
					))
				}
			</section>

			<section class="case-section" id="architecture">
				<div class="sec-head">
					<p class="eyebrow">03 · Architecture &amp; safety</p>
					<h2>五层架构，外加一条底线：不让 AI 裸奔</h2>
				</div>
				<div class="arch">
					<ol class="layers">
						{
							layers.map((layer) => (
								<li class:list={['layer', `tone-${layer.tone}`]}>
									<span>{layer.name}</span>
									<div>
										<b>{layer.tech}</b>
										<small>{layer.note}</small>
									</div>
								</li>
							))
						}
					</ol>
					<div class="safety tone-yellow">
						<h3>
							安全设计
							<span>GUARDRAILS</span>
						</h3>
						<ul>
							{safety.map((item) => <li>{item}</li>)}
						</ul>
						<p class="boundary">
							<b>边界：</b>普通的 Cursor 对话成功了，不会写成 Skill。只有 RegisterKB 流程里跑成功的任务，才进入 pending。
						</p>
					</div>
				</div>
			</section>

			<section class="case-section" id="demo">
				<div class="sec-head">
					<p class="eyebrow">04 · Demo</p>
					<h2>一次完整的 testclient 安装</h2>
				</div>
				<div class="term" data-term>
					<div class="term-bar">
						<i></i><i></i><i></i>
						<span>registerkb — demo</span>
						<button type="button" data-term-play>▶ 播放</button>
					</div>
					<div class="term-body" data-term-body>
						{
							termLines.map((line) => (
								<span class:list={['t-line', `t-${line.kind}`]} data-kind={line.kind}>{line.text}</span>
							))
						}
					</div>
					<p class="term-note">演示数据，非真实环境。</p>
				</div>
			</section>

			<section class="case-section" id="results">
				<div class="sec-head">
					<p class="eyebrow">05 · Results</p>
					<h2>结果：下一次，直接复用</h2>
				</div>
				<div class="reuse">
					<figure class="frame">
						<button class="zoom" type="button" data-zoom={img('next-time-reuse')} data-alt="下一次复用">
							<img
								src={img('next-time-reuse')}
								width="1200"
								height="800"
								loading="lazy"
								alt="四格漫画：提问 RegisterKB，找到原页面和上次验证过的 skill，自动生成验证过的 runbook，按步骤安装后所有 Pod Running"
							/>
						</button>
						<figcaption>同样的问题再来，原文页面和上次验证过的 Skill 一起找到。</figcaption>
					</figure>
					<div>
						<ul class="results">
							{results.map((item) => <li>{item}</li>)}
						</ul>
						<p class="next-label">下一步</p>
						<ul class="chips">
							{roadmap.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				</div>
			</section>
		</main>

		<footer class="case-foot">
			<div class="case-wrap">
				<p>
					RegisterKB 是我带团队在工作中做的内部工具。源码、内部文档、链接和环境信息都不公开，这里只展示思路、流程和结果。插图来自我的技术分享 PPT，已去掉公司标识。
				</p>
				<div class="foot-links">
					<a href={worksHref}>← 回到作品集</a>
					<a href={withBase('/')}>Happy OS</a>
				</div>
			</div>
		</footer>

		<dialog class="lightbox" aria-label="查看大图">
			<img src="" alt="" />
		</dialog>

		<script>
			const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-step]'));
			const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-step-panel]'));

			function selectStep(id: string, focus = false) {
				tabs.forEach((tab) => {
					const on = tab.dataset.step === id;
					tab.classList.toggle('is-active', on);
					tab.setAttribute('aria-selected', String(on));
					tab.tabIndex = on ? 0 : -1;
					if (on && focus) tab.focus();
				});
				panels.forEach((panel) => {
					panel.hidden = panel.dataset.stepPanel !== id;
				});
			}

			tabs.forEach((tab, index) => {
				tab.tabIndex = index === 0 ? 0 : -1;
				tab.addEventListener('click', () => selectStep(tab.dataset.step ?? ''));
				tab.addEventListener('keydown', (event) => {
					if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
					event.preventDefault();
					const next = (index + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
					selectStep(tabs[next].dataset.step ?? '', true);
				});
			});

			const term = document.querySelector<HTMLElement>('[data-term]');
			const termBody = document.querySelector<HTMLElement>('[data-term-body]');
			const playButton = document.querySelector<HTMLButtonElement>('[data-term-play]');
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (term && termBody && playButton && !reduceMotion) {
				const lines = Array.from(termBody.querySelectorAll<HTMLElement>('.t-line'));
				const fullText = new Map(lines.map((line) => [line, line.textContent ?? '']));
				const sleep = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, ms));
				let run = 0;

				term.classList.add('is-js');

				async function play() {
					const current = ++run;
					playButton!.textContent = '↻ 重播';
					lines.forEach((line) => {
						line.classList.remove('is-shown');
						line.textContent = fullText.get(line) ?? '';
					});
					termBody!.scrollTop = 0;

					for (const line of lines) {
						if (current !== run) return;
						line.classList.add('is-shown');
						if (line.dataset.kind === 'you') {
							const text = fullText.get(line) ?? '';
							for (let i = 1; i <= text.length; i += 1) {
								if (current !== run) return;
								line.textContent = text.slice(0, i);
								await sleep(45);
							}
							await sleep(320);
						} else {
							await sleep(line.dataset.kind === 'kb' ? 520 : 170);
						}
						termBody!.scrollTop = termBody!.scrollHeight;
					}
				}

				playButton.addEventListener('click', play);

				const observer = new IntersectionObserver(
					(entries) => {
						if (entries.some((entry) => entry.isIntersecting)) {
							observer.disconnect();
							play();
						}
					},
					{ threshold: 0.4 },
				);
				observer.observe(term);
			} else if (playButton) {
				playButton.hidden = true;
			}

			const lightbox = document.querySelector<HTMLDialogElement>('dialog.lightbox');
			const lightboxImage = lightbox?.querySelector('img');

			document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((button) => {
				button.addEventListener('click', () => {
					if (!lightbox || !lightboxImage) return;
					lightboxImage.src = button.dataset.zoom ?? '';
					lightboxImage.alt = button.dataset.alt ?? '';
					lightbox.showModal();
				});
			});

			lightbox?.addEventListener('click', () => lightbox.close());
		</script>
	</body>
</html>
