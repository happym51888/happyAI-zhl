		<script>
			const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-step]'));
			const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-step-panel]'));

			function selectStep(id: string, focus = false) {
				tabs.forEach((tab) => {
					const on = tab.dataset.step === id;
					tab.classList.toggle('is-active', on);
					tab.setAttribute('aria-selected', String(on));
					tab.tabIndex = on ? 0 : -1;
					if (on && focus) tab.focus();
				});
				panels.forEach((panel) => {
					panel.hidden = panel.dataset.stepPanel !== id;
				});
			}

			tabs.forEach((tab, index) => {
				tab.tabIndex = index === 0 ? 0 : -1;
				tab.addEventListener('click', () => selectStep(tab.dataset.step ?? ''));
				tab.addEventListener('keydown', (event) => {
					if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
					event.preventDefault();
					const next = (index + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
					selectStep(tabs[next].dataset.step ?? '', true);
				});
			});

			const term = document.querySelector<HTMLElement>('[data-term]');
			const termBody = document.querySelector<HTMLElement>('[data-term-body]');
			const playButton = document.querySelector<HTMLButtonElement>('[data-term-play]');
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (term && termBody && playButton && !reduceMotion) {
				const lines = Array.from(termBody.querySelectorAll<HTMLElement>('.t-line'));
				const fullText = new Map(lines.map((line) => [line, line.textContent ?? '']));
				const sleep = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, ms));
				let run = 0;

				term.classList.add('is-js');

				async function play() {
					const current = ++run;
					playButton!.textContent = '↻ 重播';
					lines.forEach((line) => {
						line.classList.remove('is-shown');
						line.textContent = fullText.get(line) ?? '';
					});
					termBody!.scrollTop = 0;

					for (const line of lines) {
						if (current !== run) return;
						line.classList.add('is-shown');
						if (line.dataset.kind === 'you') {
							const text = fullText.get(line) ?? '';
							for (let i = 1; i <= text.length; i += 1) {
								if (current !== run) return;
								line.textContent = text.slice(0, i);
								await sleep(45);
							}
							await sleep(320);
						} else {
							await sleep(line.dataset.kind === 'kb' ? 520 : 170);
						}
						termBody!.scrollTop = termBody!.scrollHeight;
					}
				}

				playButton.addEventListener('click', play);

				const observer = new IntersectionObserver(
					(entries) => {
						if (entries.some((entry) => entry.isIntersecting)) {
							observer.disconnect();
							play();
						}
					},
					{ threshold: 0.4 },
				);
				observer.observe(term);
			} else if (playButton) {
				playButton.hidden = true;
			}

			const lightbox = document.querySelector<HTMLDialogElement>('dialog.lightbox');
			const lightboxImage = lightbox?.querySelector('img');

			document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((button) => {
				button.addEventListener('click', () => {
					if (!lightbox || !lightboxImage) return;
					lightboxImage.src = button.dataset.zoom ?? '';
					lightboxImage.alt = button.dataset.alt ?? '';
					lightbox.showModal();
				});
			});

			lightbox?.addEventListener('click', () => lightbox.close());
		</script>
	</body>
